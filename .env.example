APP_NAME=HR AI Screening System
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:6432/hr_ai_screening

LLM_PROVIDER=mock
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_CONCURRENCY_LIMIT=4

TELEGRAM_BOT_TOKEN=
BOT_USERNAME=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=15
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_POLLING_TIMEOUT_SECONDS=25
TELEGRAM_POLLING_RETRY_DELAY_SECONDS=3

INVITE_TOKEN_TTL_HOURS=168

EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_EMAIL_FROM=HR AI Screening <onboarding@resend.dev>

PROCESSING_CONCURRENCY_LIMIT=4
MAX_UPLOAD_SIZE_MB=50
ZIP_MAX_MEMBERS=200
ZIP_MAX_TOTAL_SIZE_MB=200

DEFAULT_HR_EMAIL=hr@example.com
DEFAULT_HR_PASSWORD=change-me
DEFAULT_HR_COMPANY=Demo Company
